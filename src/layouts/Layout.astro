---
import { commonText, navigationText } from '../data/content.mjs';
import { siteConfig } from '../data/site.mjs';
import { series } from '../data/catalog';
import { withBase, seriesUrl, homeUrl } from '../lib/paths';
import '../styles/global.css';
import '../styles/titles.css';
import '../styles/showcase.css';
interface Props { title?: string; description?: string; activeSeries?: string; home?: boolean; canonicalPath?: string; immersive?: boolean }
const { title, description = siteConfig.description, activeSeries, home = false, canonicalPath, immersive = false } = Astro.props;
const canonical = new URL(canonicalPath ?? (Astro.url.pathname.endsWith('/404/') ? withBase('/404.html') : Astro.url.pathname), siteConfig.origin).href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | ${siteConfig.name}` : `${siteConfig.name} — ${navigationText.portalSubtitle}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b0e" />
    <meta property="og:title" content={title ?? siteConfig.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={new URL(withBase('/images/xeno-series-logo.webp'), siteConfig.origin).href} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
  </head>
  <body class:list={{ 'immersive-page': immersive }}>
    <a class="skip-link" href="#main">{commonText.skip}</a>
    <header class="site-header">
      {!home && <a class="wordmark" href={homeUrl} aria-label={commonText.homeLink}><img src={withBase('/images/xeno-series-logo.webp')} alt="" width="1100" height="619" /></a>}
      <nav aria-label={commonText.menu}>
        {home ? <><a href="#series">{commonText.seriesMenu} <span aria-hidden="true">↗</span></a><a href="#history">{commonText.history}</a><a href={withBase('/about/')}>{commonText.aboutMenu}</a></> : <>
          {series.map((item) => <a href={seriesUrl(item.id)} data-series={item.id} aria-current={activeSeries === item.id ? 'page' : undefined}>{item.korean}</a>)}
        </>}
      </nav>
      <span class="header-note">{commonText.fanPortal}<span class="status-dot" aria-hidden="true"></span></span>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div><a class="footer-brand" href={homeUrl}>{commonText.footerTitle}<span aria-hidden="true"> / </span></a><p>{commonText.footerDescription}</p></div>
      <div class="footer-links"><a href={withBase('/about/')}>{commonText.sources}</a><a href={siteConfig.repository} target="_blank" rel="noopener noreferrer">{commonText.repository} <span aria-hidden="true">↗</span><span class="sr-only">{' ' + commonText.newWindow}</span></a></div>
      <p class="copyright">{commonText.copyright}</p>
    </footer>
  </body>
</html>
