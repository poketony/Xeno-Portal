---
import { catalogText, navigationText } from '../data/content.mjs';
import { series, works, workEditions, xenosagaLineup } from '../data/catalog';
import WorkCard from './WorkCard.astro';
import { patches } from '../data/patches';
interface Props { seriesId?: string; showFilters?: boolean }
const { seriesId, showFilters = true } = Astro.props;
const isSaga = seriesId === 'xenosaga';
const entries = works.filter((work) => !seriesId || work.series === seriesId).map((work) => {
  const editions = workEditions(work.id);
  return { ...work, platforms: [...new Set(editions.map((edition) => edition.platform))], date: editions.map((edition) => edition.releaseDate).filter(Boolean).sort()[0] ?? '', search: [work.title, work.english, work.japanese, ...work.aliases, ...editions.map((edition) => edition.name)].join(' '), korean: editions.some((edition) => edition.korean === 'supported'), patchCount: patches.filter((patch) => patch.workId === work.id).length };
}).sort((a,b) => (a.date || '9999').localeCompare(b.date || '9999'));
const platforms = [...new Set(entries.flatMap((entry) => entry.platforms))];
const kinds = [...new Set(entries.map((entry) => entry.kind))];
---
<div class:list={['catalog', { 'catalog-showcase': !!seriesId }]} data-catalog data-fixed-order={isSaga ? 'true' : undefined}>
  {showFilters && <><form class="catalog-filters" role="search" aria-label={catalogText.searchLabel}>
    <div class="search-field"><label for="work-search">{catalogText.search}</label><div><span aria-hidden="true">⌕</span><input id="work-search" type="search" name="q" placeholder={catalogText.placeholder} autocomplete="off" /></div></div>
    {!seriesId && <div><label for="series-filter">{catalogText.series}</label><select id="series-filter" name="series"><option value="">{catalogText.allSeries}</option>{series.map((item) => <option value={item.id}>{item.korean}</option>)}</select></div>}
    <div><label for="platform-filter">{catalogText.platform}</label><select id="platform-filter" name="platform"><option value="">{catalogText.allPlatforms}</option>{platforms.map((platform) => <option>{platform}</option>)}</select></div>
    <div><label for="kind-filter">{catalogText.kind}</label><select id="kind-filter" name="kind"><option value="">{catalogText.allWorks}</option>{kinds.map((kind) => <option>{kind}</option>)}</select></div>
    {!isSaga && <div><label for="sort-order">{catalogText.sort}</label><select id="sort-order" name="sort"><option value="oldest">{catalogText.oldest}</option><option value="newest">{catalogText.newest}</option></select></div>}
    <button class="filter-reset" type="reset">{catalogText.reset}</button>
  </form>
  <div class="catalog-meta"><p data-result-count role="status" aria-live="polite">{catalogText.count.replace('{count}', String(entries.length))}</p><span>{isSaga ? catalogText.sagaOrder : catalogText.dateOrder}</span></div></>}
  <div class:list={['work-grid', { 'saga-lineup': isSaga }]} data-work-list>
    {isSaga ? xenosagaLineup.map((group) => <section class="saga-chapter" data-chapter-group aria-label={`${navigationText.episode} ${group.episode} · ${catalogText.sideKind}`}>
      <WorkCard entry={entries.find((entry) => entry.id === group.mainId)!} episode={group.episode} />
      {group.sideIds.length > 0 && <div class="saga-interlude" data-interlude>
        <div class="interlude-heading"><span class="interlude-line" aria-hidden="true"></span><p>{group.between}<span>{catalogText.sideOrder}</span></p></div>
        <div class="side-work-grid">{group.sideIds.map((id) => <WorkCard entry={entries.find((entry) => entry.id === id)!} compact />)}</div>
      </div>}
    </section>) : entries.map((entry) => <WorkCard entry={entry} />)}
  </div>
  <div class="empty-state" data-no-results hidden><span aria-hidden="true">∅</span><h3>{catalogText.emptyTitle}</h3><p>{catalogText.emptyDescription}</p><button class="button secondary" type="button" data-clear>{catalogText.clear}</button></div>
  {showFilters && <noscript><p class="notice">{catalogText.noScript}</p></noscript>}
  <script type="application/json" data-catalog-data set:html={JSON.stringify(entries.map(({ id, title, search, series, platforms, kind, date }) => ({ id, title, search, series, platforms, kind, date }))).replace(/</g, '\\u003c')} />
</div>
<script>
  import { catalogText } from '../data/content.mjs';
  import { filterCatalog } from '../lib/catalog.mjs';
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form');
    if (!form) return;
    const list = root.querySelector<HTMLElement>('[data-work-list]')!;
    const entries = JSON.parse(root.querySelector('[data-catalog-data]')!.textContent!);
    const cards = new Map([...list.querySelectorAll<HTMLElement>('[data-work-id]')].map((card) => [card.dataset.workId, card]));
    const update = () => {
      const values = Object.fromEntries(new FormData(form).entries());
      const matches = filterCatalog(entries, { ...values, query: String(values.q ?? '') });
      cards.forEach((card) => { card.hidden = true; });
      matches.forEach((entry: { id: string }) => {
        const card = cards.get(entry.id)!;
        card.hidden = false;
        if (root.dataset.fixedOrder !== 'true') list.append(card);
      });
      for (const group of list.querySelectorAll<HTMLElement>('[data-chapter-group], [data-interlude]')) {
        group.hidden = !group.querySelector('[data-work-id]:not([hidden])');
      }
      root.querySelector('[data-result-count]')!.textContent = catalogText.count.replace('{count}', String(matches.length));
      root.querySelector<HTMLElement>('[data-no-results]')!.hidden = matches.length > 0;
      const params = new URLSearchParams();
      for (const [key, value] of Object.entries(values)) if (value && !(key === 'sort' && value === 'oldest')) params.set(key, String(value));
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
    };
    new URLSearchParams(location.search).forEach((value, key) => {
      const field = form.elements.namedItem(key);
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value;
    });
    form.addEventListener('submit', (event) => { event.preventDefault(); update(); });
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    form.addEventListener('reset', () => setTimeout(update));
    root.querySelector('[data-clear]')?.addEventListener('click', () => form.reset());
    update();
  });
</script>
