---
import Layout from '../layouts/Layout.astro';
import GameStage from './GameStage.astro';
import { showcases, workPatchLinks } from '../data/showcase';
import { series, workEditions, koreanLabels } from '../data/catalog';
import { patches } from '../data/patches';
import { resources } from '../data/resources';
import { withBase, seriesUrl, workUrl, homeUrl } from '../lib/paths';
interface Props { work: import('../data/catalog').Work }
const { work } = Astro.props;
const isGears = work.id === 'xenogears';
const parent = series.find((item) => item.id === work.series)!;
const showcase = work.series === 'xenogears' ? showcases.xenogears : work.id === 'xenosaga-1' ? showcases['xenosaga-1'] : work.series === 'xenosaga' ? showcases.xenosaga : undefined;
const artwork = work.image ?? (isGears ? parent.artwork : undefined);
const editions = workEditions(work.id);
const workPatches = patches.filter((patch) => patch.workId === work.id);
const workResources = resources.filter((resource) => resource.workIds.includes(work.id));
const sources = [...work.sources, ...(work.image ? [work.image.source] : [])];
---
{showcase ? <Layout title={work.title} description={work.summary} activeSeries={work.series} canonicalPath={isGears ? workUrl(work.id) : undefined} immersive>
  <GameStage seriesId={work.series} title={isGears ? work.english : work.title} subtitle={isGears ? work.title : work.english} subtitleLang={isGears ? 'ko' : 'en'} description={work.summary} features={work.features} logo={isGears ? showcase.logo : undefined} slides={showcase.slides} patchUrl={workPatchLinks[work.id]}>
    <Fragment slot="actions">{work.series === 'xenosaga' && <>{work.id === 'missing-year' && <a class="text-link" href={withBase('/watch/missing-year/')}>미싱 이어 감상 ↗</a>}<a class="text-link" href={seriesUrl(parent.id)}>← 제노사가 작품 선택</a></>}</Fragment>
  </GameStage>
</Layout> : <Layout title={work.title} description={work.summary} activeSeries={work.series} canonicalPath={isGears ? workUrl(work.id) : undefined}>
  <div class="page-shell game-shell">
    <nav class="breadcrumbs" aria-label="현재 위치"><a href={homeUrl}>홈</a><span aria-hidden="true">/</span>{!isGears && <><a href={seriesUrl(parent.id)}>{parent.korean}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{work.title}</span></nav>
    <header class:list={['game-hero', { 'game-hero-gears': isGears }]}>
      <div class="game-copy">
        <p class="eyebrow">{[...new Set(editions.map((edition) => edition.platform))].join(' · ')} / {work.kind}</p>
        <h1>{isGears ? <img class="series-logo" src={withBase(parent.logo.src)} alt={work.english} width={parent.logo.width} height={parent.logo.height} fetchpriority="high" /> : work.title}</h1>
        <p class="game-subtitle" lang={isGears ? 'ko' : 'en'}>{isGears ? work.title : work.english}</p>
        <p class="game-intro">{work.summary}</p>
        <ul class="game-highlights" aria-label="게임의 주요 특징">{work.features.map((feature) => <li>{feature}</li>)}</ul>
        <div class="button-group">{work.id === 'missing-year' && <a class="button" href={withBase('/watch/missing-year/')}>미싱 이어 감상 페이지 ↗</a>}<a class="button secondary" href="#patches">한글패치 ↓</a><a class="text-link" href="#resources">관련 자료 ↗</a></div>
      </div>
      <div class:list={['game-artwork', { 'has-game-image': !!artwork }]}>
        <img src={withBase(artwork?.src ?? '/images/' + work.series + '.svg')} alt={artwork?.alt ?? parent.korean + ' 포털 그래픽'} width={isGears ? 600 : 1000} height={isGears ? 800 : 400} fetchpriority="high" />
        {!artwork && <span aria-hidden="true">{parent.name}</span>}
      </div>
    </header>
    <nav class="section-nav" aria-label="한글패치와 자료"><a href="#patches">한글패치</a><a href="#resources">관련 자료</a><a href="#editions">기종·판본</a></nav>
    <section id="editions" class="content-section"><div class="section-heading"><div><p class="eyebrow">EDITIONS & PLATFORMS</p><h2>기종과 판본</h2></div></div><p class="section-description">발매 정보는 표시된 지역 기준입니다. 공식 한국어 지원과 팬 한글패치는 별도로 안내합니다.</p><div class="edition-list">{editions.map((edition) => <article id={`edition-${edition.id}`} class="edition-row"><div><span class="eyebrow">{edition.platform} / {edition.region}</span><h3>{edition.name}</h3>{edition.note && <p>{edition.note}</p>}<div class="edition-sources">{edition.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗<span class="sr-only"> (새 창)</span></a>)}</div></div><div class="edition-facts"><time datetime={edition.releaseDate ?? undefined}>{edition.releaseDate ?? '발매일 미확인'}</time><span class:list={['tag', { official: edition.korean === 'supported' }]}>{koreanLabels[edition.korean]}</span></div></article>)}</div></section>
    <section id="patches" class="content-section"><div class="section-heading"><div><p class="eyebrow">KOREAN TRANSLATION</p><h2>한글패치</h2></div></div>{workPatches.length ? workPatches.map((patch) => <article class="patch-detail" id={`patch-${patch.id}`}><h3>{patch.name}</h3><dl class="detail-list"><dt>제작자</dt><dd>{patch.author}</dd><dt>대상 판본</dt><dd>{patch.editionIds.map((id) => editions.find((edition) => edition.id === id)?.name ?? id).join(' · ')}</dd><dt>버전</dt><dd>{patch.version ?? '미등록'}</dd><dt>배포일</dt><dd>{patch.releaseDate ?? '미등록'}</dd><dt>파일 크기</dt><dd>{patch.fileSize ?? '미등록'}</dd></dl><div class="button-group">{patch.distributionUrl && <a class="button secondary" href={patch.distributionUrl}>배포 페이지 ↗</a>}{patch.downloadUrl && <a class="button" href={patch.downloadUrl}>패치 다운로드 ↗</a>}{patch.mirrors?.map((mirror) => <a class="button secondary" href={mirror.url}>{mirror.label} ↗</a>)}</div>{!patch.downloadUrl && !patch.distributionUrl && <p class="notice">배포 링크가 등록되지 않았습니다.</p>}<h4>적용 방법</h4>{patch.instructions.length ? <ol>{patch.instructions.map((line) => <li>{line}</li>)}</ol> : <p>적용 방법이 등록되지 않았습니다.</p>}<h4>변경 사항</h4>{patch.changes.length ? <ul>{patch.changes.map((line) => <li>{line}</li>)}</ul> : <p>변경 사항이 등록되지 않았습니다.</p>}<h4>알려진 문제</h4>{patch.knownIssues.length ? <ul>{patch.knownIssues.map((line) => <li>{line}</li>)}</ul> : <p>알려진 문제 정보가 등록되지 않았습니다.</p>}{patch.originalFiles?.length && <><h4>원본 파일 식별 정보</h4>{patch.originalFiles.map((file) => <p>{file.name} · {file.algorithm}<code class="file-hash">{file.hash}</code></p>)}</>}</article>) : <div class="empty-inline"><span aria-hidden="true">＋</span><div><h3>아직 등록된 한글패치가 없습니다</h3><p>확인된 배포 링크가 등록되면 이곳에서 안내합니다. 패치의 제작 여부나 진행 상태는 등록된 정보만으로 표시합니다.</p></div></div>}</section>
    <section id="resources" class="content-section"><div class="section-heading"><div><p class="eyebrow">RELATED MATERIALS</p><h2>관련 자료</h2></div></div>{workResources.length ? <div class="resource-list">{workResources.map((resource) => <a class="resource-row" href={withBase(`/resources/${resource.id}/`)}><div><span class="tag">{resource.type}</span><h3>{resource.title}</h3><p>{resource.description}</p></div><span aria-hidden="true">↗</span></a>)}</div> : <p class="empty-inline">등록된 관련 자료가 없습니다.</p>}</section>
    <section class="content-section source-section"><h2>참고 출처</h2>{sources.length ? <ul>{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗<span class="sr-only"> (새 창)</span></a></li>)}</ul> : <p>소개는 운영자가 제공한 제작 요청을 기준으로 작성했습니다. 원본 자료와 외부 출처는 추가 등록이 필요합니다.</p>}<a class="text-link" href={isGears ? homeUrl : seriesUrl(parent.id)}>← {isGears ? '포털 홈으로 돌아가기' : `${parent.korean} 시리즈로 돌아가기`}</a></section>
  </div>
</Layout>}
