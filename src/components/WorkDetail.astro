---
import { workPageText } from '../data/content.mjs';
import Layout from '../layouts/Layout.astro';
import GameStage from './GameStage.astro';
import { showcases, workPatchLinks } from '../data/showcase';
import { series, workEditions, koreanLabels } from '../data/catalog';
import { patches } from '../data/patches';
import { resources } from '../data/resources';
import { withBase, seriesUrl, workUrl, homeUrl } from '../lib/paths';
interface Props { work: import('../data/catalog').Work }
const { work } = Astro.props;
const isGears = work.id === 'xenogears';
const parent = series.find((item) => item.id === work.series)!;
const showcase = showcases[work.id as keyof typeof showcases] ?? (work.series === 'xenosaga' ? showcases.xenosaga : undefined);
const artwork = work.image ?? (isGears ? parent.artwork : undefined);
const editions = workEditions(work.id);
const workPatches = patches.filter((patch) => patch.workId === work.id);
const workResources = resources.filter((resource) => resource.workIds.includes(work.id));
const sources = [...work.sources, ...(work.image ? [work.image.source] : [])];
---
{showcase ? <Layout title={work.title} description={work.summary} activeSeries={work.series} canonicalPath={isGears ? workUrl(work.id) : undefined} immersive>
  <GameStage seriesId={work.series} workId={work.id} title={isGears ? work.english : work.title} subtitle={isGears ? work.title : work.english} subtitleLang={isGears ? 'ko' : 'en'} description={work.summary} features={work.features} logo={isGears ? showcases.xenogears.logo : undefined} slides={showcase.slides} patchUrl={workPatchLinks[work.id]} patchPending={work.id === 'xenosaga-2' || work.id === 'xenosaga-3' || work.id === 'xenosaga-freaks'}>
    <Fragment slot="actions">{work.series === 'xenosaga' && <>{work.id === 'missing-year' && <a class="stage-back-link stage-watch-link" href={withBase('/watch/missing-year/')}>{workPageText.watch}</a>}<a class="stage-back-link" href={seriesUrl(parent.id)}>{workPageText.backToSaga.replace(/^←\s*/, '')}</a></>}</Fragment>
  </GameStage>
</Layout> : <Layout title={work.title} description={work.summary} activeSeries={work.series} canonicalPath={isGears ? workUrl(work.id) : undefined}>
  <div class="page-shell game-shell">
    <nav class="breadcrumbs" aria-label={workPageText.location}><a href={homeUrl}>{workPageText.home}</a><span aria-hidden="true">/</span>{!isGears && <><a href={seriesUrl(parent.id)}>{parent.korean}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{work.title}</span></nav>
    <header class:list={['game-hero', { 'game-hero-gears': isGears }]}>
      <div class="game-copy">
        <p class="eyebrow">{[...new Set(editions.map((edition) => edition.platform))].join(' · ')} / {work.kind}</p>
        <h1>{isGears ? <img class="series-logo" src={withBase(parent.logo.src)} alt={work.english} width={parent.logo.width} height={parent.logo.height} fetchpriority="high" /> : work.title}</h1>
        <p class="game-subtitle" lang={isGears ? 'ko' : 'en'}>{isGears ? work.title : work.english}</p>
        <p class="game-intro">{work.summary}</p>
        <ul class="game-highlights" aria-label={workPageText.features}>{work.features.map((feature) => <li>{feature}</li>)}</ul>
        <div class="button-group">{work.id === 'missing-year' && <a class="button" href={withBase('/watch/missing-year/')}>{workPageText.watchPage}</a>}<a class="button secondary" href="#patches">{workPageText.patchAction}</a><a class="text-link" href="#resources">{workPageText.resourcesAction}</a></div>
      </div>
      <div class:list={['game-artwork', { 'has-game-image': !!artwork }]}>
        <img src={withBase(artwork?.src ?? '/images/' + work.series + '.svg')} alt={artwork?.alt ?? parent.korean + workPageText.portalGraphic} width={isGears ? 600 : 1000} height={isGears ? 800 : 400} fetchpriority="high" />
        {!artwork && <span aria-hidden="true">{parent.name}</span>}
      </div>
    </header>
    <nav class="section-nav" aria-label={workPageText.nav}><a href="#patches">{workPageText.patches}</a><a href="#resources">{workPageText.resources}</a><a href="#editions">{workPageText.editionsShort}</a></nav>
    <section id="editions" class="content-section"><div class="section-heading"><div><p class="eyebrow">{workPageText.editionsEyebrow}</p><h2>{workPageText.editions}</h2></div></div><p class="section-description">{workPageText.editionsDescription}</p><div class="edition-list">{editions.map((edition) => <article id={`edition-${edition.id}`} class="edition-row"><div><span class="eyebrow">{edition.platform} / {edition.region}</span><h3>{edition.name}</h3>{edition.note && <p>{edition.note}</p>}<div class="edition-sources">{edition.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗<span class="sr-only">{workPageText.newWindow}</span></a>)}</div></div><div class="edition-facts"><time datetime={edition.releaseDate ?? undefined}>{edition.releaseDate ?? workPageText.unknownDate}</time><span class:list={['tag', { official: edition.korean === 'supported' }]}>{koreanLabels[edition.korean]}</span></div></article>)}</div></section>
    <section id="patches" class="content-section"><div class="section-heading"><div><p class="eyebrow">{workPageText.translationEyebrow}</p><h2>{workPageText.patches}</h2></div></div>{workPatches.length ? workPatches.map((patch) => <article class="patch-detail" id={`patch-${patch.id}`}><h3>{patch.name}</h3><dl class="detail-list"><dt>{workPageText.author}</dt><dd>{patch.author}</dd><dt>{workPageText.target}</dt><dd>{patch.editionIds.map((id) => editions.find((edition) => edition.id === id)?.name ?? id).join(' · ')}</dd><dt>{workPageText.version}</dt><dd>{patch.version ?? workPageText.unregistered}</dd><dt>{workPageText.releaseDate}</dt><dd>{patch.releaseDate ?? workPageText.unregistered}</dd><dt>{workPageText.fileSize}</dt><dd>{patch.fileSize ?? workPageText.unregistered}</dd></dl><div class="button-group">{patch.distributionUrl && <a class="button secondary" href={patch.distributionUrl}>{workPageText.distribution}</a>}{patch.downloadUrl && <a class="button" href={patch.downloadUrl}>{workPageText.download}</a>}{patch.mirrors?.map((mirror) => <a class="button secondary" href={mirror.url}>{mirror.label} ↗</a>)}</div>{!patch.downloadUrl && !patch.distributionUrl && <p class="notice">{workPageText.noLink}</p>}<h4>{workPageText.instructions}</h4>{patch.instructions.length ? <ol>{patch.instructions.map((line) => <li>{line}</li>)}</ol> : <p>{workPageText.noInstructions}</p>}<h4>{workPageText.changes}</h4>{patch.changes.length ? <ul>{patch.changes.map((line) => <li>{line}</li>)}</ul> : <p>{workPageText.noChanges}</p>}<h4>{workPageText.issues}</h4>{patch.knownIssues.length ? <ul>{patch.knownIssues.map((line) => <li>{line}</li>)}</ul> : <p>{workPageText.noIssues}</p>}{patch.originalFiles?.length && <><h4>{workPageText.originalFiles}</h4>{patch.originalFiles.map((file) => <p>{file.name} · {file.algorithm}<code class="file-hash">{file.hash}</code></p>)}</>}</article>) : <div class="empty-inline"><span aria-hidden="true">＋</span><div><h3>{workPageText.noPatchesTitle}</h3><p>{workPageText.noPatchesDescription}</p></div></div>}</section>
    <section id="resources" class="content-section"><div class="section-heading"><div><p class="eyebrow">{workPageText.resourcesEyebrow}</p><h2>{workPageText.resources}</h2></div></div>{workResources.length ? <div class="resource-list">{workResources.map((resource) => <a class="resource-row" href={withBase(`/resources/${resource.id}/`)}><div><span class="tag">{resource.type}</span><h3>{resource.title}</h3><p>{resource.description}</p></div><span aria-hidden="true">↗</span></a>)}</div> : <p class="empty-inline">{workPageText.noResources}</p>}</section>
    <section class="content-section source-section"><h2>{workPageText.sources}</h2>{sources.length ? <ul>{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗<span class="sr-only">{workPageText.newWindow}</span></a></li>)}</ul> : <p>{workPageText.noSources}</p>}<a class="text-link" href={isGears ? homeUrl : seriesUrl(parent.id)}>← {isGears ? workPageText.backHome : `${parent.korean} ${workPageText.backSeries}`}</a></section>
  </div>
</Layout>}
