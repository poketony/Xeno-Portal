---
import Layout from '../layouts/Layout.astro';
import { works, series, workEditions, koreanLabels } from '../data/catalog';
import { patches } from '../data/patches';
import { resources } from '../data/resources';
import { withBase, seriesUrl, workUrl } from '../lib/paths';
interface Props { work: import('../data/catalog').Work }
const { work } = Astro.props;
const isGears = work.id === 'xenogears';
const parent = series.find((item) => item.id === work.series)!;
const editions = workEditions(work.id);
const workPatches = patches.filter((patch) => patch.workId === work.id);
const workResources = resources.filter((resource) => resource.workIds.includes(work.id));
const sources = [...work.sources, ...(work.image ? [work.image.source] : [])];
---
<Layout title={work.title} description={work.summary} activeSeries={work.series} canonicalPath={isGears ? workUrl(work.id) : undefined}>
  <div class:list={['page-shell', { 'gears-shell': isGears }]}>
    <nav class="breadcrumbs" aria-label="현재 위치"><a href={withBase('/')}>홈</a><span aria-hidden="true">/</span>{!isGears && <><a href={seriesUrl(parent.id)}>{parent.korean}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{work.title}</span></nav>
    {isGears ? <>
      <header class="gears-hero">
        <img class="gears-key-visual" src={withBase(work.image?.src ?? '/images/xenogears.svg')} alt={work.image?.alt ?? '거대한 기어와 기계의 궤적을 그린 제노기어스 포털 그래픽'} width="1000" height="400" fetchpriority="high" />
        <div class="gears-hero-content">
          <p class="eyebrow">XENO ARCHIVE / PLAYSTATION</p>
          <p class="gears-catch">소년의 여정에서,<br />세계의 비밀로.</p>
          <h1><span lang="en">{work.english}</span><span class="gears-korean">{work.title}<span lang="ja">{work.japanese}</span></span></h1>
          <p class="gears-intro">{work.summary}</p>
          <a class="gears-release" href="#editions"><time datetime={editions[0].releaseDate ?? undefined}>{editions[0].releaseDate?.replaceAll('-', '.')}</time><span>PlayStation · 일본 발매</span><span aria-hidden="true">↗</span></a>
        </div>
        {!work.image && <span class="gears-art-caption">포털 오리지널 그래픽</span>}
      </header>
      <nav class="gears-explore" aria-label="제노기어스 둘러보기">
        <a href="#overview"><span class="eyebrow">01 / STORY</span><strong>이야기 속으로</strong><span>기억과 세계의 비밀 <span aria-hidden="true">↘</span></span></a>
        <a href="#features"><span class="eyebrow">02 / BATTLE</span><strong>인물과 기어</strong><span>두 가지 규모의 전투 <span aria-hidden="true">↘</span></span></a>
        <a href="#patches"><span class="eyebrow">03 / KOREAN PATCH</span><strong>한국어로 만나는 여정</strong><span>한글패치와 관련 자료 <span aria-hidden="true">↘</span></span></a>
      </nav>
    </> : <>
      <header class="work-hero"><div class={`work-cover ${work.series}${work.image ? ' has-image' : ''}`}><img src={withBase(work.image?.src ?? `/images/${work.series}.svg`)} alt={work.image?.alt ?? `${parent.korean} 포털 그래픽 — 작품 이미지 미등록`} width="1000" height="400" />{!work.image && <><span aria-hidden="true">{parent.name}</span><p>작품 대표 이미지 미등록 · 포털 그래픽</p></>}</div><div><p class="eyebrow">{parent.name.toUpperCase()} / {work.kind}</p><h1>{work.title}</h1><p class="english-title" lang="en">{work.english}</p>{work.japanese && <p class="japanese-title" lang="ja">{work.japanese}</p>}<p class="work-lead">{work.summary}</p>{work.id === 'missing-year' ? <a class="button" href={withBase('/watch/missing-year/')}>미싱 이어 감상 페이지 <span aria-hidden="true">↗</span></a> : <a class="button secondary" href="#patches">한글패치 확인 <span aria-hidden="true">↓</span></a>}</div></header>
      <nav class="section-nav" aria-label="작품 안에서 찾기"><a href="#overview">작품 소개</a><a href="#editions">기종·판본</a><a href="#patches">한글패치</a><a href="#resources">관련 자료</a></nav>
    </>}
    <section id="overview" class:list={['content-section', { 'gears-story': isGears }]}>
      <div class="section-heading"><div><p class="eyebrow">{isGears ? 'STORY / THE BEGINNING' : 'OVERVIEW'}</p><h2>{isGears ? '기억을 따라, 세계를 마주하다.' : '이 작품에 대하여'}</h2></div></div>
      {isGears && <p class="gears-story-copy">페이와 거대한 인간형 병기 기어.<br />인물들의 기억과 만남을 따라 세계의 비밀로 향하는 이야기를 만나보세요.</p>}
      <ul class="feature-list">{work.features.map((feature) => <li>{feature}</li>)}</ul>
      {work.related.length > 0 && <div class="related-works"><h3>함께 살펴볼 작품</h3>{work.related.map((id) => { const related = works.find((entry) => entry.id === id)!; return <a class="text-link" href={workUrl(id)}>{related.title} ↗</a>; })}</div>}
    </section>
    {isGears && <section id="features" class="content-section gears-battle"><div class="section-heading"><div><p class="eyebrow">BATTLE / HUMAN & GEAR</p><h2>인물과 기어를 오가는 전투</h2></div></div><div class="gears-battle-grid"><article><span aria-hidden="true">01</span><div><p class="eyebrow">HUMAN</p><h3>인물들의 전투</h3><p>각 인물과 함께 싸우며 여정을 이어 갑니다.</p></div></article><article><span aria-hidden="true">02</span><div><p class="eyebrow">GEAR</p><h3>거대한 기어의 전투</h3><p>기어에 올라 또 다른 규모의 전투를 만납니다.</p></div></article></div></section>}
    <section id="editions" class="content-section"><div class="section-heading"><div><p class="eyebrow">EDITIONS & PLATFORMS</p><h2>기종과 판본</h2></div></div><p class="section-description">발매 정보는 표시된 지역 기준입니다. 공식 한국어 지원과 팬 한글패치는 별도로 안내합니다.</p><div class="edition-list">{editions.map((edition) => <article id={`edition-${edition.id}`} class="edition-row"><div><span class="eyebrow">{edition.platform} / {edition.region}</span><h3>{edition.name}</h3>{edition.note && <p>{edition.note}</p>}<div class="edition-sources">{edition.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗<span class="sr-only"> (새 창)</span></a>)}</div></div><div class="edition-facts"><time datetime={edition.releaseDate ?? undefined}>{edition.releaseDate ?? '발매일 미확인'}</time><span class:list={['tag', { official: edition.korean === 'supported' }]}>{koreanLabels[edition.korean]}</span></div></article>)}</div></section>
    <section id="patches" class="content-section"><div class="section-heading"><div><p class="eyebrow">KOREAN TRANSLATION</p><h2>한글패치</h2></div></div>{workPatches.length ? workPatches.map((patch) => <article class="patch-detail" id={`patch-${patch.id}`}><h3>{patch.name}</h3><dl class="detail-list"><dt>제작자</dt><dd>{patch.author}</dd><dt>대상 판본</dt><dd>{patch.editionIds.map((id) => editions.find((edition) => edition.id === id)?.name ?? id).join(' · ')}</dd><dt>버전</dt><dd>{patch.version ?? '미등록'}</dd><dt>배포일</dt><dd>{patch.releaseDate ?? '미등록'}</dd><dt>파일 크기</dt><dd>{patch.fileSize ?? '미등록'}</dd></dl><div class="button-group">{patch.distributionUrl && <a class="button secondary" href={patch.distributionUrl}>배포 페이지 ↗</a>}{patch.downloadUrl && <a class="button" href={patch.downloadUrl}>패치 다운로드 ↗</a>}{patch.mirrors?.map((mirror) => <a class="button secondary" href={mirror.url}>{mirror.label} ↗</a>)}</div>{!patch.downloadUrl && !patch.distributionUrl && <p class="notice">배포 링크가 등록되지 않았습니다.</p>}<h4>적용 방법</h4>{patch.instructions.length ? <ol>{patch.instructions.map((line) => <li>{line}</li>)}</ol> : <p>적용 방법이 등록되지 않았습니다.</p>}<h4>변경 사항</h4>{patch.changes.length ? <ul>{patch.changes.map((line) => <li>{line}</li>)}</ul> : <p>변경 사항이 등록되지 않았습니다.</p>}<h4>알려진 문제</h4>{patch.knownIssues.length ? <ul>{patch.knownIssues.map((line) => <li>{line}</li>)}</ul> : <p>알려진 문제 정보가 등록되지 않았습니다.</p>}{patch.originalFiles?.length && <><h4>원본 파일 식별 정보</h4>{patch.originalFiles.map((file) => <p>{file.name} · {file.algorithm}<code class="file-hash">{file.hash}</code></p>)}</>}</article>) : <div class="empty-inline"><span aria-hidden="true">＋</span><div><h3>아직 등록된 한글패치가 없습니다</h3><p>확인된 배포 링크가 등록되면 이곳에서 안내합니다. 패치의 제작 여부나 진행 상태는 등록된 정보만으로 표시합니다.</p></div></div>}</section>
    <section id="resources" class="content-section"><div class="section-heading"><div><p class="eyebrow">RELATED MATERIALS</p><h2>관련 자료</h2></div></div>{workResources.length ? <div class="resource-list">{workResources.map((resource) => <a class="resource-row" href={withBase(`/resources/${resource.id}/`)}><div><span class="tag">{resource.type}</span><h3>{resource.title}</h3><p>{resource.description}</p></div><span aria-hidden="true">↗</span></a>)}</div> : <p class="empty-inline">등록된 관련 자료가 없습니다.</p>}</section>
    <section class="content-section source-section"><h2>참고 출처</h2>{sources.length ? <ul>{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗<span class="sr-only"> (새 창)</span></a></li>)}</ul> : <p>소개는 운영자가 제공한 제작 요청을 기준으로 작성했습니다. 원본 자료와 외부 출처는 추가 등록이 필요합니다.</p>}<a class="text-link" href={isGears ? withBase('/') : seriesUrl(parent.id)}>← {isGears ? '포털 홈으로 돌아가기' : `${parent.korean} 시리즈로 돌아가기`}</a></section>
  </div>
</Layout>
