---
import { resourcePageText } from '../../data/content.mjs';
import Layout from '../../layouts/Layout.astro';
import { resources } from '../../data/resources';
import { works, series } from '../../data/catalog';
import { withBase, workUrl, seriesUrl, homeUrl } from '../../lib/paths';
export function getStaticPaths() { return resources.map((resource) => ({ params: { resource: resource.id }, props: { resource } })); }
const { resource } = Astro.props;
const work = works.find((work) => work.id === resource.workIds[0])!;
const parent = series.find((entry) => entry.id === work.series)!;
---
<Layout title={resource.title} description={resource.description} activeSeries={parent.id}>
  <article class="page-shell narrow-shell"><nav class="breadcrumbs" aria-label={resourcePageText.location}><a href={homeUrl}>{resourcePageText.home}</a><span aria-hidden="true">/</span><a href={seriesUrl(parent.id)}>{parent.korean}</a><span aria-hidden="true">/</span><span aria-current="page">{resourcePageText.library}</span></nav><header class="page-title"><p class="eyebrow">ARCHIVE / {resource.type}</p><h1>{resource.title}</h1><p>{resource.description}</p></header>{resource.thumbnail && <img class="resource-thumbnail" src={withBase(resource.thumbnail)} alt={resource.title} />}<section class="content-section"><h2>{resourcePageText.instructions}</h2><p>{resource.instructions ?? resourcePageText.noInstructions}</p><div class="button-group">{resource.url && <a class="button" href={withBase(resource.url)}>{resource.id === 'missing-year' ? resourcePageText.watch : resourcePageText.open} ↗</a>}{resource.downloadable && resource.file && <a class="button secondary" href={withBase(resource.file)} download>{resourcePageText.download}</a>}</div>{!resource.downloadable && <p class="subtle">{resourcePageText.noDownload}</p>}</section><section class="content-section"><h2>{resourcePageText.related}</h2><div class="related-works">{resource.workIds.map((id) => <a class="text-link" href={workUrl(id)}>{works.find((work) => work.id === id)!.title} ↗</a>)}</div></section><section class="content-section"><h2>{resourcePageText.source}</h2>{resource.source ? <a href={resource.source.url}>{resource.source.title} ↗</a> : <p>{resourcePageText.noSource}</p>}</section></article>
</Layout>
