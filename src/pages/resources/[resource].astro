---
import Layout from '../../layouts/Layout.astro';
import { resources } from '../../data/resources';
import { works, series } from '../../data/catalog';
import { withBase, workUrl, seriesUrl } from '../../lib/paths';
export function getStaticPaths() { return resources.map((resource) => ({ params: { resource: resource.id }, props: { resource } })); }
const { resource } = Astro.props;
const work = works.find((work) => work.id === resource.workIds[0])!;
const parent = series.find((entry) => entry.id === work.series)!;
---
<Layout title={resource.title} description={resource.description} activeSeries={parent.id}>
  <article class="page-shell narrow-shell"><nav class="breadcrumbs" aria-label="현재 위치"><a href={withBase('/')}>홈</a><span aria-hidden="true">/</span><a href={seriesUrl(parent.id)}>{parent.korean}</a><span aria-hidden="true">/</span><span aria-current="page">자료실</span></nav><header class="page-title"><p class="eyebrow">ARCHIVE / {resource.type}</p><h1>{resource.title}</h1><p>{resource.description}</p></header>{resource.thumbnail && <img class="resource-thumbnail" src={withBase(resource.thumbnail)} alt={resource.title} />}<section class="content-section"><h2>이용 안내</h2><p>{resource.instructions ?? '별도의 조작 안내가 등록되지 않았습니다.'}</p><div class="button-group">{resource.url && <a class="button" href={withBase(resource.url)}>{resource.id === 'missing-year' ? '전용 감상 페이지 열기' : '자료 열기'} ↗</a>}{resource.downloadable && resource.file && <a class="button secondary" href={withBase(resource.file)} download>원본 자료 다운로드</a>}</div>{!resource.downloadable && <p class="subtle">이 자료는 원본 다운로드를 제공하지 않습니다.</p>}</section><section class="content-section"><h2>관련 작품</h2><div class="related-works">{resource.workIds.map((id) => <a class="text-link" href={workUrl(id)}>{works.find((work) => work.id === id)!.title} ↗</a>)}</div></section><section class="content-section"><h2>출처</h2>{resource.source ? <a href={resource.source.url}>{resource.source.title} ↗</a> : <p>원본 자료와 출처 정보가 아직 등록되지 않았습니다.</p>}</section></article>
</Layout>
