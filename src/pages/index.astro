---
import HomeChronicle from '../components/HomeChronicle.astro';
import { homeText } from '../data/content.mjs';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site.mjs';
import { series } from '../data/catalog';
import { seriesUrl, withBase } from '../lib/paths';
---
<Layout home>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-coordinate" aria-hidden="true">{homeText.coordinate}<span>{homeText.locale}</span></div>
    <img class="hero-logo" src={withBase('/images/xeno-series-logo.webp')} alt={homeText.logoAlt} width="1100" height="619" fetchpriority="high" />
    <p class="eyebrow hero-eyebrow">{homeText.eyebrow}</p>
    <h1 id="hero-title">{siteConfig.name}</h1>
    <div class="hero-description"><p>{siteConfig.description}</p></div>
    <a class="hero-scroll" href="#series"><span>{homeText.scroll}</span><span aria-hidden="true">↓</span></a>
    <span class="hero-axis" aria-hidden="true">{homeText.axis}</span>
  </section>
  <section class="series-section" id="series" aria-labelledby="series-title">
    <div class="section-kicker"><h2 id="series-title">{homeText.seriesHeading}</h2><span>{homeText.seriesSubtitle}</span></div>
    <div class="series-banners">
      {series.map((item) => <a class={`series-banner ${item.id}`} href={seriesUrl(item.id)}>
        <img class="banner-art" src={withBase(item.artwork?.src ?? `/images/${item.id}.svg`)} alt={item.artwork?.alt ?? ''} width={item.artwork?.width ?? 1000} height={item.artwork?.height ?? 400} loading="lazy" />
        <span class="banner-scan" aria-hidden="true"></span>
        <div class="banner-content"><span class="banner-topline"><span class="banner-index">{item.number}</span><span>{item.motif}</span></span><h3><img class="series-logo" src={withBase(item.logo.src)} alt={item.name} width={item.logo.width} height={item.logo.height} loading="lazy" /></h3><p><span class="banner-ko">{item.korean}</span><span class="banner-dash" aria-hidden="true">—</span>{item.id === 'xenoblade' ? homeText.officialSite : item.tagline}</p></div>
        <span class="banner-arrow" aria-hidden="true">↗</span>
        <span class="sr-only">{item.id === 'xenoblade' ? ' ' + homeText.officialAction : item.id === 'xenogears' ? ' ' + homeText.workAction : ' ' + homeText.seriesAction}</span>
      </a>)}
    </div>
  </section>
  <HomeChronicle />
  <aside class="home-note"><span class="note-cross" aria-hidden="true">+</span><div><p class="eyebrow">{homeText.archive.eyebrow}</p><p>{homeText.archive.title}</p><span>{homeText.archive.description}</span></div><a href={withBase('/about/')} aria-label={homeText.archive.actionLabel}>{homeText.archive.action} <span aria-hidden="true">↗</span></a></aside>
</Layout>
