---
import { searchText, commonText } from '../../data/content.mjs';
import Layout from '../../layouts/Layout.astro';
import Catalog from '../../components/Catalog.astro';
import { homeUrl } from '../../lib/paths';
---
<Layout title={searchText.title} description={searchText.description}>
  <div class="page-shell"><nav class="breadcrumbs" aria-label={commonText.location}><a href={homeUrl}>{commonText.home}</a><span aria-hidden="true">/</span><span aria-current="page">{searchText.breadcrumb}</span></nav><header class="page-title"><p class="eyebrow">{searchText.eyebrow}</p><h1>{searchText.heading}</h1><p>{searchText.intro}</p></header><Catalog /></div>
</Layout>
