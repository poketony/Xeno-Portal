---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site.mjs';
import { aboutText as text, commonText } from '../data/content.mjs';
import { homeUrl, withBase } from '../lib/paths';
---
<Layout title={text.title} description={text.description}>
  <article class="page-shell narrow-shell">
    <nav class="breadcrumbs" aria-label={commonText.location}><a href={homeUrl}>{commonText.home}</a><span aria-hidden="true">/</span><span aria-current="page">{commonText.aboutMenu}</span></nav>
    <header class="page-title"><p class="eyebrow">{text.eyebrow}</p><h1 style="white-space:pre-line">{text.heading}</h1><p>{text.introduction}</p></header>
    {text.sections.map((section, index) => <section class="content-section"><h2>{section.title}</h2>
      {index === 2 && <ul>{text.sourceNotes.map((parts) => <li>{parts.map((part) => part.url ? <a href={part.url.startsWith('/') ? withBase(part.url) : part.url}>{part.text}</a> : part.text)}</li>)}</ul>}
      {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {index === text.sections.length - 1 && <a class="button secondary" href={siteConfig.repository}>{text.repository}</a>}
    </section>)}
  </article>
</Layout>
