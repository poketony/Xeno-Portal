---
import Layout from '../../layouts/Layout.astro';
import Catalog from '../../components/Catalog.astro';
import WorkDetail from '../../components/WorkDetail.astro';
import { series, works } from '../../data/catalog';
import { patches } from '../../data/patches';
import { resources } from '../../data/resources';
import { withBase, workUrl, homeUrl } from '../../lib/paths';
export function getStaticPaths() { return series.map((item) => ({ params: { series: item.id }, props: { item } })); }
const { item } = Astro.props;
const ids = works.filter((work) => work.series === item.id).map((work) => work.id);
const relatedResources = resources.filter((resource) => resource.workIds.some((id) => ids.includes(id)));
const relatedPatches = patches.filter((patch) => ids.includes(patch.workId));
---
{item.id === 'xenogears' ? <WorkDetail work={works.find((work) => work.id === 'xenogears')!} /> : <Layout title={item.korean} description={item.description} activeSeries={item.id}>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="현재 위치"><a href={homeUrl}>홈</a><span aria-hidden="true">/</span><span aria-current="page">{item.korean}</span></nav>
    <header class:list={['series-hero', item.id, { 'has-artwork': !!item.artwork }]}><img src={withBase(item.artwork?.src ?? `/images/${item.id}.svg`)} alt={item.artwork?.alt ?? ''} width={item.artwork?.width ?? 1000} height={item.artwork?.height ?? 400} /><div><p class="eyebrow">SERIES {item.number} / {item.motif}</p><h1>{item.name}</h1><p class="series-korean">{item.korean}<span>— {item.tagline}</span></p><p>{item.description}</p></div></header>
    <nav class="section-nav" aria-label="시리즈 안에서 찾기"><a href="#patches">한글패치</a><a href="#resources">자료실</a><a href="#updates">업데이트</a></nav>
    <section id="works" class="content-section" aria-label={`${item.korean} 본편과 외전`}><Catalog seriesId={item.id} showFilters={false} /></section>
    <section id="patches" class="content-section"><div class="section-heading"><div><p class="eyebrow">KOREAN TRANSLATION</p><h2>한글패치</h2></div></div>{relatedPatches.length ? <div class="resource-list">{relatedPatches.map((patch) => <a class="resource-row" href={`${workUrl(patch.workId)}#patch-${patch.id}`}><div><span class="tag">한글패치</span><h3>{patch.name}</h3><p>{patch.author}{patch.version ? ` · ${patch.version}` : ''}</p></div><span aria-hidden="true">↗</span></a>)}</div> : <div class="empty-inline"><span aria-hidden="true">＋</span><div><h3>아직 등록된 한글패치가 없습니다</h3><p>배포 정보가 등록되면 대상 작품·기종·판본과 함께 안내합니다. 이 표시는 패치의 제작 여부나 진행 상태를 뜻하지 않습니다.</p></div></div>}</section>
    <section id="resources" class="content-section"><div class="section-heading"><div><p class="eyebrow">BEYOND THE GAME</p><h2>자료실</h2></div></div>{relatedResources.length ? <div class="resource-list">{relatedResources.map((resource) => <a class="resource-row" href={withBase(`/resources/${resource.id}/`)}><div><span class="tag">{resource.type}</span><h3>{resource.title}</h3><p>{resource.description}</p></div><span aria-hidden="true">↗</span></a>)}</div> : <p class="empty-inline">등록된 관련 자료가 없습니다.</p>}</section>
    <section id="updates" class="content-section"><div class="section-heading"><div><p class="eyebrow">ARCHIVE LOG</p><h2>업데이트</h2></div></div>{relatedPatches.length ? relatedPatches.map((patch) => <a class="resource-row" href={`${workUrl(patch.workId)}#patch-${patch.id}`}><div><span class="eyebrow">{patch.releaseDate ?? '배포일 미등록'}{patch.version ? ` / ${patch.version}` : ''}</span><h3>{patch.name}</h3><p>{patch.changes[0] ?? '작품 페이지에서 배포 정보와 변경 사항을 확인하세요.'}</p></div><span aria-hidden="true">↗</span></a>) : <p class="empty-inline">등록된 패치 배포·자료 업데이트 기록이 없습니다.</p>}</section>
  </div>
</Layout>}
