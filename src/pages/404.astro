---
import { notFoundText } from '../data/content.mjs';
import Layout from '../layouts/Layout.astro';
import { homeUrl } from '../lib/paths';
---
<Layout title={notFoundText.title}>
  <div class="page-shell narrow-shell"><header class="page-title"><p class="eyebrow">{notFoundText.eyebrow}</p><h1>{notFoundText.heading}</h1><p>{notFoundText.description}</p></header><a class="button" href={homeUrl}>{notFoundText.action}</a></div>
</Layout>
