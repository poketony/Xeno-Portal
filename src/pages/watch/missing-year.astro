---
import { watchText } from '../../data/content.mjs';
import Layout from '../../layouts/Layout.astro';
import { chapters, ruffleVersion } from '../../data/missing-year';
import { withBase, seriesUrl, workUrl, homeUrl } from '../../lib/paths';
const ordered = [...chapters].sort((a,b) => a.order - b.order);
---
<Layout title={watchText.title} description={watchText.description} activeSeries="xenosaga">
  <div class="page-shell watch-shell">
    <nav class="breadcrumbs" aria-label={watchText.location}><a href={homeUrl}>{watchText.home}</a><span aria-hidden="true">/</span><a href={seriesUrl('xenosaga')}>{watchText.saga}</a><span aria-hidden="true">/</span><a href={workUrl('missing-year')}>{watchText.name}</a><span aria-hidden="true">/</span><span aria-current="page">{watchText.breadcrumb}</span></nav>
    <header class="page-title watch-title"><p class="eyebrow">{watchText.eyebrow}</p><h1>{watchText.english}<span>{watchText.name}</span></h1><p>{watchText.intro}</p><p class="subtle">{watchText.spoiler}</p></header>
    <div data-missing-year data-ruffle-url={withBase('/vendor/ruffle/ruffle.js')} data-ruffle-base={withBase('/vendor/ruffle/')} data-base={withBase('/')}>
      <div class="theater-toolbar"><label for="chapter-select">{watchText.chapter}</label><select id="chapter-select" disabled={!ordered.length}>{ordered.length ? ordered.map((chapter) => <option value={chapter.id}>{chapter.title}</option>) : <option>{watchText.noChapters}</option>}</select><button type="button" class="text-button" data-last hidden>{watchText.lastChapter}</button></div>
      <div class="theater" data-theater>
        <div class="player-host" data-player-host></div>
        <div class="theater-overlay" data-player-overlay><span class="theater-symbol" aria-hidden="true">▷</span><p class="eyebrow">{watchText.playerEyebrow}</p><h2 data-player-title>{ordered.length ? watchText.readyTitle : watchText.emptyTitle}</h2><p data-player-status role="status" aria-live="polite">{ordered.length ? watchText.readyStatus : watchText.emptyStatus}</p><button class="button" type="button" data-start hidden={!ordered.length}>{watchText.start} <span aria-hidden="true">→</span></button></div>
      </div>
      <div class="player-controls"><div class="button-group"><button type="button" class="control-button" data-previous disabled>{watchText.previous}</button><button type="button" class="control-button" data-next disabled>{watchText.next}</button></div><div class="button-group"><button type="button" class="control-button" data-pause disabled>{watchText.pause}</button><button type="button" class="control-button" data-restart disabled>{watchText.restart}</button><label class="volume-control">{watchText.volume}<input type="range" min="0" max="1" step="0.05" value="0.8" aria-label={watchText.volume} data-volume disabled /></label><button type="button" class="control-button" data-fullscreen disabled>{watchText.fullscreen}</button></div></div>
      <div class="chapter-status"><p data-selected-chapter>{ordered.length ? ordered[0].title : watchText.noStructure}</p><a class="text-link" data-download hidden download>{watchText.download}</a></div>
      <script type="application/json" data-chapter-data set:html={JSON.stringify(ordered).replace(/</g, '\\u003c')} />
    </div>
    <div class="watch-notes"><section><p class="eyebrow">{watchText.guideEyebrow}</p><h2>{watchText.guideTitle}</h2><p>{watchText.guide}</p><p>{watchText.sound}</p></section><section><p class="eyebrow">{watchText.statusEyebrow}</p><h2>{watchText.statusTitle}</h2><p>{watchText.status.replace('{version}', ruffleVersion)}</p><a class="text-link" href={workUrl('missing-year')}>{watchText.aboutWork}</a></section></div>
    <noscript><p class="notice">{watchText.noScript}</p></noscript>
  </div>
</Layout>
<script>
  import '../../scripts/missing-year';
</script>
