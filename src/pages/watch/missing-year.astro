---
import Layout from '../../layouts/Layout.astro';
import { chapters, ruffleVersion } from '../../data/missing-year';
import { withBase, seriesUrl, workUrl } from '../../lib/paths';
const ordered = [...chapters].sort((a,b) => a.order - b.order);
---
<Layout title="제노사가 미싱 이어 감상" description="에피소드 II와 III 사이를 잇는 A Missing Year의 소개와 장별 감상 페이지입니다." activeSeries="xenosaga">
  <div class="page-shell watch-shell">
    <nav class="breadcrumbs" aria-label="현재 위치"><a href={withBase('/')}>홈</a><span aria-hidden="true">/</span><a href={seriesUrl('xenosaga')}>제노사가</a><span aria-hidden="true">/</span><a href={workUrl('missing-year')}>미싱 이어</a><span aria-hidden="true">/</span><span aria-current="page">감상</span></nav>
    <header class="page-title watch-title"><p class="eyebrow">XENOSAGA / DIGITAL THEATER</p><h1>A Missing Year<span>미싱 이어</span></h1><p>에피소드 II와 III 사이, 기록되지 않았던 이야기.</p><p class="subtle">에피소드 II의 내용을 포함합니다. 원본 자료의 버튼으로 텍스트와 장면을 진행하세요.</p></header>
    <div data-missing-year data-ruffle-url={withBase('/vendor/ruffle/ruffle.js')} data-ruffle-base={withBase('/vendor/ruffle/')} data-base={withBase('/')}>
      <div class="theater-toolbar"><label for="chapter-select">장 선택</label><select id="chapter-select" disabled={!ordered.length}>{ordered.length ? ordered.map((chapter) => <option value={chapter.id}>{chapter.title}</option>) : <option>등록된 장이 없습니다</option>}</select><button type="button" class="text-button" data-last hidden>마지막으로 연 장 열기 ↗</button></div>
      <div class="theater" data-theater>
        <div class="player-host" data-player-host></div>
        <div class="theater-overlay" data-player-overlay><span class="theater-symbol" aria-hidden="true">▷</span><p class="eyebrow">A MISSING YEAR</p><h2 data-player-title>{ordered.length ? '이야기를 시작할 준비가 되었습니다' : '아직 감상 자료가 등록되지 않았습니다'}</h2><p data-player-status role="status" aria-live="polite">{ordered.length ? '감상 시작을 누르면 원본 자료를 불러옵니다.' : '원본 SWF와 부속 파일이 등록되면 이곳에서 감상할 수 있습니다.'}</p><button class="button" type="button" data-start hidden={!ordered.length}>감상 시작 <span aria-hidden="true">→</span></button></div>
      </div>
      <div class="player-controls"><div class="button-group"><button type="button" class="control-button" data-previous disabled>← 이전 장</button><button type="button" class="control-button" data-next disabled>다음 장 →</button></div><div class="button-group"><button type="button" class="control-button" data-pause disabled>일시정지</button><button type="button" class="control-button" data-restart disabled>다시 시작</button><label class="volume-control">음량<input type="range" min="0" max="1" step="0.05" value="0.8" aria-label="음량" data-volume disabled /></label><button type="button" class="control-button" data-fullscreen disabled>전체 화면</button></div></div>
      <div class="chapter-status"><p data-selected-chapter>{ordered.length ? ordered[0].title : '장 구성 미등록'}</p><a class="text-link" data-download hidden download>원본 SWF 다운로드 ↓</a></div>
      <script type="application/json" data-chapter-data set:html={JSON.stringify(ordered).replace(/</g, '\\u003c')} />
    </div>
    <div class="watch-notes"><section><p class="eyebrow">HOW TO WATCH</p><h2>감상 안내</h2><p>장 선택 후 감상을 시작하세요. 텍스트 진행과 선택 버튼은 원본 화면 안에서 조작합니다. 사이트는 마지막으로 연 장만 이 브라우저에 저장합니다.</p><p>소리가 들리지 않으면 브라우저의 소리 재생 허용 여부와 음량을 확인하세요.</p></section><section><p class="eyebrow">PLAYBACK STATUS</p><h2>자료와 재생 상태</h2><p>Ruffle {ruffleVersion} 공식 웹 배포본을 사용합니다. 원본 SWF가 아직 제공되지 않아 문자·버튼·음성·장면 전환의 실제 호환성 검증은 남아 있습니다.</p><a class="text-link" href={workUrl('missing-year')}>작품 소개와 관련 자료 ↗</a></section></div>
    <noscript><p class="notice">Flash 자료를 감상하려면 JavaScript를 켜 주세요.</p></noscript>
  </div>
</Layout>
<script>
  import '../../scripts/missing-year';
</script>
